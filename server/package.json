    "express": "^4.21",
    "express-fileupload": "^1.5",
    "express-rate-limit": "^7.5.0",
    "jsbarcode": "^3.12",
    "jsonwebtoken": "^9",
    "mongoose": "^8.19.0",
    "node-telegram-bot-api": "0.67.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
