{
  "name": "stickifyme-server",
  "version": "1.0.0",
  "description": "StickifyMe API server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=../.env server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "canvas2pdf": "^1.0.7",
    "cors": "^2.8.5",
    "express": "^4.17.1",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^7.5.0",
    "jsbarcode": "^3.11.5",
    "jsonwebtoken": "^8.5.1",
    "mongoose": "^8.19.0",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.7.8",
    "pdfkit": "^0.13.0",
    "svg-to-pdfkit": "^0.1.8",
    "xmldom": "^0.6.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
