{
  "name": "stickifyme-server",
  "version": "1.0.0",
  "description": "StickifyMe API server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.js",
    "typecheck": "tsc --noEmit",
    "pretest": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "yarn build && vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@xmldom/xmldom": "^0.9",
    "bcryptjs": "^3",
    "cors": "^2.8.5",
    "express": "^4.21",
    "express-fileupload": "^1.5",
    "express-rate-limit": "^7.5.0",
    "jsbarcode": "^3.12",
    "jsonwebtoken": "^9",
    "mongoose": "^8.19.0",
    "node-telegram-bot-api": "0.67.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.17",
    "pino": "^9",
    "pino-http": "^10",
    "svg-to-pdfkit": "^0.1.8",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17",
    "@types/express-fileupload": "^1.5.1",
    "@types/jsonwebtoken": "^9",
    "@types/node": "^22",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.0",
    "pino-pretty": "^13",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "resolutions": {
    "proxy-addr": "^2.0.8",
    "crypto-js": "^4.2.0"
  }
}
