# Copy to .env and adjust. Every variable is optional for a local run:
# `docker compose up --build` works without a .env file at all.

# ---------- docker compose ----------
# Host ports for the web app and the API (change if 3000/4000 are busy).
# docker compose derives CORS_ORIGINS, APP_URL and NEXT_PUBLIC_* URLs from them.
WEB_PORT=3000
API_PORT=4000

# ---------- API server (server/) ----------
# Secret for signing user JWTs. REQUIRED outside docker compose.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-to-a-long-random-string

# Full MongoDB connection string. docker compose overrides it with the internal mongo service.
MONGO_URI=mongodb://localhost:27017/stickifyme

# Log level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# HTTP port of the API server.
PORT=4000

# Comma-separated list of origins allowed by CORS (the web app URL).
CORS_ORIGINS=http://localhost:3000

# Public URL of the web app, used for links in emails (password reset, verification).
APP_URL=http://localhost:3000

# Max requests per 15 minutes per IP to sign-in / sign-up / password reset endpoints.
AUTH_RATE_LIMIT_MAX=20

# Number of reverse proxies in front of the API (0 = none). Needed for correct client IPs.
TRUST_PROXY=0

# Where to send admin notifications (new signups, crashes). Empty = disabled.
ADMIN_EMAIL=

# SMTP for outgoing email. Empty SMTP_HOST = emails are written to the log instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="StickifyMe" <no-reply@example.com>

# Telegram bot token from @BotFather. Empty = monitoring notifications are only logged.
TELEGRAM_BOT_TOKEN=

# How often warehouse acceptance coefficients are polled per user, in milliseconds.
MONITORING_INTERVAL_MS=17000

# ---------- Wildberries API ----------
# Base URLs of the WB seller API. docker compose points them to the local mock (wb-mock).
WB_MARKETPLACE_API_URL=https://marketplace-api.wildberries.ru
WB_CONTENT_API_URL=https://content-api.wildberries.ru
WB_SUPPLIES_API_URL=https://supplies-api.wildberries.ru
# Per-request timeout and retry policy (exponential backoff with jitter; 429 honours Retry-After).
WB_TIMEOUT_MS=15000
WB_MAX_RETRIES=4
WB_RETRY_BASE_DELAY_MS=1000
WB_RETRY_MAX_DELAY_MS=65000
# Orders are imported in batches of this size with a pause between batches (WB sticker limits).
WB_STICKERS_BATCH_SIZE=15
WB_BATCH_DELAY_MS=60000
# AES-256-GCM key for sellers' WB API keys stored in MongoDB: 32 random bytes, base64.
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WB_KEY_ENCRYPTION_KEY=

# ---------- Web app (Next.js) ----------
# NEXT_PUBLIC_* are baked into the browser bundle at build time.
# Base URL of the API as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public URL of the web app (canonical / Open Graph tags).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Contact email shown on the support and legal pages.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
# Telegram bot username without @, used for the "connect bot" deep link.
NEXT_PUBLIC_TELEGRAM_BOT_NAME=your_monitoring_bot
# Link to a Telegram channel or chat for support.
NEXT_PUBLIC_TELEGRAM_CHANNEL_URL=https://t.me/
